# Template for the per-environment env files. NODE_ENV picks which one
# the app, the TypeORM CLI, and the scripts/ tools all load
# (src/libs/env/env-file.ts):
#
#   NODE_ENV=local  -> .env.local   (npm run start:dev, npm run migration:*)
#   NODE_ENV=prod   -> .env.prod    (npm run migration:*:prod)
#   unset           -> .env
#
#   cp .env.example .env.local
#   cp .env.example .env.prod
#
# All three are gitignored. A deployed host that injects real environment
# variables (Render, Docker, CI) needs no file at all — real env vars
# always win over file values.

# --- Environment ---
NODE_ENV=local

# --- Database ---
# Two ways to point at Postgres; DATABASE_URL wins when set. Managed
# providers (Render, Railway, Supabase, Neon) hand you exactly one
# connection string, so use that in .env.prod. The POSTGRES_* parts are
# usually nicer locally — one value to change instead of re-editing a URL.
DATABASE_URL=""
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="spotly_dev"
POSTGRES_USER="spotly"
POSTGRES_PASSWORD="your_password_here"

# TLS to the database. Off locally; "true" for any hosted Postgres you
# reach over the public internet. DATABASE_CA_CERT is optional — supply
# the provider's CA to get full certificate verification.
DATABASE_SSL=false
DATABASE_CA_CERT=""

# Log every SQL statement — useful when debugging a migration, noisy
# otherwise.
DATABASE_LOGGING=false

# --- Auth ---
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="7d"

# --- M-Pesa Daraja (fill in from Safaricom Developer Portal) ---
MPESA_ENV="sandbox"                 # sandbox | production
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""                  # Paybill/Till number
MPESA_PASSKEY=""                    # Lipa Na M-Pesa Online passkey
MPESA_CALLBACK_URL=""               # public HTTPS URL Daraja will POST to

# --- Media storage (Cloudinary) ---
# Leave blank for local dev: uploads are written to ./uploads and served
# from /uploads/. Fill these in (from your Cloudinary dashboard's "API
# Environment variable" section) and the app switches to Cloudinary
# automatically — required before deploying, since a container's local
# disk doesn't survive a restart.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Base URL this API is reachable at — used to build /uploads/ URLs in
# local-disk mode. Defaults to http://localhost:$PORT.
PUBLIC_API_URL=""

# --- First admin (npm run seed:admin) ---
# Who src/database/seeds/admin.seed.ts creates or promotes. The seed
# generates a random password and emails it — you never set one here.
ADMIN_EMAIL=""
ADMIN_NAME="Spotly Admin"
# Where the "log in" button in that email points. Falls back to FRONTEND_URL.
ADMIN_APP_URL=""

# --- Email (Resend) ---
RESEND_API_KEY=""                   # from resend.com — without this, emails are logged, not sent
EMAIL_FROM="Spotly <onboarding@resend.dev>"  # switch to your own verified domain address before real launch

# --- OAuth (Phase 1 real integration; MVP simulates these per BRD Section 11) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
APPLE_CALLBACK_URL="http://localhost:3000/auth/apple/callback"

# Where OAuth callbacks redirect back to after a successful login
FRONTEND_URL="http://localhost:3001"

PORT=3000
