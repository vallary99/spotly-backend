# --- Core infra (already configured for this sandbox) ---
DATABASE_URL="postgresql://spotly:your_password_here@localhost:5432/spotly_dev"
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth ---
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="7d"

# --- M-Pesa Daraja (fill in from Safaricom Developer Portal) ---
MPESA_ENV="sandbox"                 # sandbox | production
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""                  # Paybill/Till number
MPESA_PASSKEY=""                    # Lipa Na M-Pesa Online passkey
MPESA_CALLBACK_URL=""               # public HTTPS URL Daraja will POST to

# --- Object storage — pick ONE: S3-compatible (AWS S3/Cloudflare R2) or
# Cloudinary. STORAGE_PROVIDER selects explicitly; if it's unset (or the
# credentials for what it names aren't actually filled in), the app
# falls back to whichever provider DOES have real credentials, then to
# local disk. Leave everything blank for local dev.
STORAGE_PROVIDER="s3"                # "s3" or "cloudinary"

# S3 / Cloudflare R2
STORAGE_ENDPOINT=""                 # leave blank for AWS S3; set for R2/MinIO
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="spotly-media"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""          # CDN/public URL prefix for serving media

# Cloudinary — from your Cloudinary dashboard's "API Environment variable"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email (Resend) ---
RESEND_API_KEY=""                   # from resend.com — without this, emails are logged, not sent
EMAIL_FROM="Spotly <onboarding@resend.dev>"  # switch to your own verified domain address before real launch

# --- OAuth (Phase 1 real integration; MVP simulates these per BRD Section 11) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
APPLE_CALLBACK_URL="http://localhost:3000/auth/apple/callback"

# Where OAuth callbacks redirect back to after a successful login
FRONTEND_URL="http://localhost:3001"

PORT=3000
