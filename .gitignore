node_modules/
dist/
*.tsbuildinfo
*.log
uploads/

# IDE / editor
.idea/

# Env files — one per environment, selected by NODE_ENV
# (see src/libs/env/env-file.ts). Never commit real credentials;
# .env.example is the committed template.
.env
.env.local
.env.prod

# Local-only migrations (NODE_ENV=local): throwaway schema churn from
# day-to-day development. The committed history that runs against real
# data lives in src/database/migrations.
/src/database/local-migrations/*
!/src/database/local-migrations/.gitkeep
